# Android Studio - Ignore entire .idea directory
*.iml
.gradle
/local.properties
/.idea
/build
/captures
.externalNativeBuild

# 凭据/环境变量：绝不能提交（含真实会话 Cookie）
.env
.env.*
*.env
# 会话凭据落盘文件（明文 Cookie）与手动导出的凭据快照
sessions.xml
*.session.json
*.cookies.txt
# 签名密钥/发布参数
keystore.properties
signing.properties
*.p12
*.pepk
.cxx
/web

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Gradle files
.gradle/
build/
app/build/

# Local configuration file
local.properties

# Log files
*.log

# Android generated files
*.apk
*.ap_
*.aab

# Android Studio generated files
*.jar
*.class

# 例外：Gradle wrapper 的 jar 必须入库，否则新克隆/CI 无法构建
!gradle/wrapper/gradle-wrapper.jar

# Keystore files
*.jks
*.keystore

# Proguard mapping files
proguard/

# Generated files
app/debug/
app/release/

# Temporary files
*.tmp
*.temp

# Module specific build directories
*/build/

# Firebase configuration
google-services.json

# Crashlytics configuration
crashlytics.properties

# Node.js
node_modules/
npm-debug.log*

# Web files (if any)
web/dist/

# Kotlin build files
.kotlin/

# Editor specific files
.vscode/
*.swp
*.swo
